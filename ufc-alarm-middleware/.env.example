# Cito API key (https://citoapi.com/ufc-api/) — sent as the `x-api-key` header.
# Este é o UNICO processo em toda a infra do ufc-alarm que deve conhecer essa chave.
CITO_API_KEY=

# Opcional — chave de uma segunda conta Cito, usada como reserva só quando
# CITO_API_KEY bate no limite mensal (429). Mesmo formato/origem da acima.
CITO_API_KEY_FALLBACK=

# Opcional — chave de uma terceira conta Cito, usada como reserva só quando
# CITO_API_KEY e CITO_API_KEY_FALLBACK já bateram no limite mensal (429).
# Mesmo formato/origem das acima.
CITO_API_KEY_FALLBACK_2=

# Opcional — chave de uma quarta conta Cito, usada como reserva só quando
# todas as anteriores já bateram no limite mensal (429). Mesmo formato/
# origem das acima.
CITO_API_KEY_FALLBACK_3=

# Chave interna que ufc-alarm-front (web e worker) devem enviar no header
# `x-internal-key`. Gerar com: openssl rand -hex 32
MIDDLEWARE_INTERNAL_KEY=

# Opcional — defaults já cobrem uso normal:
# PORT=3005
# HOST=0.0.0.0
# CITO_BASE_URL=https://api.citoapi.com
# CACHE_TTL_EVENTS_MS=3600000
# CACHE_TTL_EVENT_STATS_MS=1800000
# CACHE_TTL_LIVE_MS=90000

# Opcional — webhook do Discord para alertar quando uma Cito API key estourar
# a cota (429) e, com severidade maior, quando todas estourarem ao mesmo
# tempo. Sem isso configurado, os alertas são simplesmente não enviados.
DISCORD_WEBHOOK_URL=
