# Cito API key (https://citoapi.com/ufc-api/) — sent as the `x-api-key` header.
# Never expose this to the client; it's only read server-side in lib/api/citoClient.ts.
CITO_API_KEY=

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Dev-only testing aid (ignored in production, no-op unless set): comma-separated
# alarm ids to force-report as "live" so the ring/sound/stop flow can be tested
# without waiting for a real live UFC card. Get an id from the `alarms` table
# (e.g. `sqlite3 .data/app.db "SELECT id FROM alarms"`).
DEV_FORCE_LIVE_ALARM_IDS=

# --- Mobile / Firebase push (used only by scripts/mobile-alarm-worker.ts) ---
# Path to the Firebase service account JSON (Firebase console > Project
# Settings > Service Accounts > Generate new private key). Never commit this
# file — keep it under .secrets/, which is gitignored.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Dev-only testing aid, parallel to DEV_FORCE_LIVE_ALARM_IDS above but for
# device_alarms ids (mobile, anonymous alarms) instead of the web's user
# alarms. Get an id from `sqlite3 .data/app.db "SELECT id FROM device_alarms"`.
DEV_FORCE_LIVE_DEVICE_ALARM_IDS=

# How often the worker polls for live status, in milliseconds. Defaults to
# 60000 (60s) in code if unset.
MOBILE_ALARM_WORKER_INTERVAL_MS=
