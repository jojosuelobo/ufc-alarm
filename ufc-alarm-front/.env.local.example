# Cito API key (https://citoapi.com/ufc-api/) — sent as the `x-api-key` header.
# Never expose this to the client; it's only read server-side in lib/api/citoClient.ts.
CITO_API_KEY=

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Dev-only testing aid (ignored in production, no-op unless set): comma-separated
# alarm ids to force-report as "live" so the ring/sound/stop flow can be tested
# without waiting for a real live UFC card. Get an id from the `alarms` table
# (e.g. `sqlite3 .data/app.db "SELECT id FROM alarms"`).
DEV_FORCE_LIVE_ALARM_IDS=
